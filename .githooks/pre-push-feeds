#!/bin/sh
# Pre-push hook: enforce that `feeds/` changes are CI-generated only.
#
# Feeds must be regenerated by the CI pipeline (update.yml);
# human pushes that modify feeds/ must be rejected.
#
# Bypass deliberately: SKIP_FEED_PUSH=1 git push ...
#
# This hook is called from .githooks/pre-push.

ZERO=0000000000000000000000000000000000000000

if [ "${SKIP_FEED_PUSH:-}" = "1" ]; then
    echo "[pre-push-feeds] SKIP_FEED_PUSH=1 -- feeds/ check bypassed."
    exit 0
fi

# CI bot identity used by GitHub Actions for auto-generated commits
IS_CI_BOT() {
    local who="$1"
    echo "$who" | grep -qiE '(github-actions|ci-bot|team-)'
}

found_feeds_change=0

while read -r _local_ref local_oid _remote_ref remote_oid; do
    [ "$local_oid" = "$ZERO" ] && continue  # branch deletion — nothing to check

    if [ "$remote_oid" = "$ZERO" ]; then
        # New branch: all commits in local_oid
        range="$local_oid"
    else
        range="$remote_oid..$local_oid"
    fi

    # Get list of commits being pushed
    commits=$(git rev-list $range 2>/dev/null || true)
    [ -z "$commits" ] && continue

    for sha in $commits; do
        # Check if this commit modified any feeds/ file
        changed_files=$(git diff-tree --no-commit-id --name-only -r "$sha" 2>/dev/null || true)
        echo "$changed_files" | grep -q '^feeds/' || continue

        # Commit touches feeds/ — verify it's from CI
        author=$(git log -1 --format='%an' "$sha" 2>/dev/null || true)
        committer=$(git log -1 --format='%cn' "$sha" 2>/dev/null || true)

        if IS_CI_BOT "$author" || IS_CI_BOT "$committer"; then
            echo "[pre-push-feeds] OK: $sha is CI-generated (author=$author committer=$committer)"
        else
            echo "[pre-push-feeds] BLOCKED: $sha modifies feeds/ but is not from CI"
            echo "[pre-push-feeds]   author=$author  committer=$committer"
            echo "[pre-push-feeds]   feeds/ must be generated by the CI pipeline only."
            echo "[pre-push-feeds]   To bypass deliberately: SKIP_FEED_PUSH=1"
            exit 1
        fi

        found_feeds_change=1
    done
done

[ "$found_feeds_change" -eq 0 ] && echo "[pre-push-feeds] no feeds/ changes in this push."
echo "[pre-push-feeds] feeds/ policy check passed."
exit 0