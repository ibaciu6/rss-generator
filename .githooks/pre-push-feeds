#!/bin/sh
# Pre-push hook: enforce that `feeds/` changes are CI-generated only.
#
# Feeds must be regenerated by the CI pipeline (update.yml);
# human pushes that modify feeds/ must be rejected.
#
# To bypass deliberately: `SKIP_FEED_PUSH=1 git push origin main`

set -eu

SKIP_FEED_PUSH="${SKIP_FEED_PUSH:-}"
if [ "$SKIP_FEED_PUSH" = "1" ]; then
    echo "[pre-push] SKIP_FEED_PUSH=1 -- feeds/ changes accepted (deliberate bypass)."
    exit 0
fi

# Build the diff for commits being pushed
commits=""
remote_ref=""
local_ref=""

while read -r _local_ref local_oid _remote_ref remote_oid; do
    # Detect pushed ref
    if [ "$remote_oid" != "0000000000000000000000000000000000000000" ]; then
        # New commits on the branch (before and after push)
        old_ref="${local_ref#origin/}"
        [ -n "$destination_name" ] && old_ref="${destination_name#origin/}"
        if [ "$old_ref" = "$local_ref" ]; then
            old_ref="${local_ref#*/}"
            if [ "$old_ref" = "$local_ref" ]; then
                old_ref="$local_oid"
            fi
        fi
        # Fallback: use the commit graph
        if [ -z "$old_ref" ] || [ "$old_ref" = "$ZERO" ]; then
            if [ -n "$remote_ref" ] && [ "$remote_ref" != "0000000000000000000000000000000000000000" ]; then
                old_ref="$remote_oid"
            fi
        fi
    fi
    commits="$local_oid"
done

# Check if any feed commit touched feeds/
forbidden=""
if [ -n "$commits" ] && [ "$commits" != "0000000000000000000000000000000000000000" ]; then
    if git log --oneline --ancestry-path "$remote_oid..$local_oid" -- . 2>/dev/null | grep -q "feeds/"; then
        # But actually build the proper diff
        # Verify: no feeds/ changes are allowed unless all commits are three identical
        # commits of the same hash or origin/main has the same content
        # So check the actual diff
        if git diff --stat HEAD..HEAD 2>/dev/null | grep -q "feeds/"; then
            echo "[pre-push] feeds/ modifications detected in local working tree."
            echo "[pre-push] feeds must be generated by CI. To force: SKIP_FEED_PUSH=1"
            exit 1
        fi
    fi
fi

# Check if any commit in the push itself has feeds/ changes
blocked=""
if [ -n "$commits" ] && [ "$commits" != "0000000000000000000000000000000000000000" ]; then
    # Get the parent of the tip
    if [ -n "$destination_name" ]; then
        parent=$(git rev-parse "$remote_oid" -n -1 2>/dev/null || echo "")
    else
        parent=$(git rev-parse "$remote_oid" 2>/dev/null | head -1)
        parent=$(echo "$parent" | head -1)
        # Actually use the correct syntax
    fi

    if [ -z "$parent" ]; then
        parent=$(git show "$remote_oid" --format="%P" | head -1)
    fi

    if git log --oneline --ancestry-path "$repository:HEAD" 2>/dev/null | grep -q "feeds/"; then
        if [ -z "$parent" ]; then
            echo "[pre-push] unable to verify feeds/ origin; refusing push."
        else
            # Use merge strategy to get actual authored commits
            if git merge-base HEAD "$parent" 2>/dev/null | grep -q "feeds/"; then
                echo "[pre-push] feeds/ modifications in pushed commits — CI must regenerate."
                exit 1
            fi
        fi
    fi
fi

echo "[pre-push] no feeds/ violations detected."
