#!/bin/sh
# Mandatory pre-push review gate -- see AGENTS.md, "Code Review".
#
# Enable once per clone:   git config core.hooksPath .githooks
# Deliberate bypass:       SKIP_CODE_REVIEW=1 git push ...
#
# The review itself is done with the skill vendored in
# .agents/skills/talos-code-reviewer. This hook enforces the machine-checkable
# parts of the process:
#   1. every commit being pushed records the review as a `Reviewed-by:` trailer;
#   2. gitleaks scans only commits being pushed, avoiding unrelated legacy
#      findings elsewhere in the repository's history;
#   3. ruff and the test suite pass.
set -eu

ZERO=0000000000000000000000000000000000000000

if [ "${SKIP_CODE_REVIEW:-}" = "1" ]; then
    echo "[pre-push] SKIP_CODE_REVIEW=1 -- review gate bypassed deliberately."
    exit 0
fi

# --- 1. every pushed commit must record a review --------------------------
missing=""
while read -r _local_ref local_oid _remote_ref remote_oid; do
    [ "$local_oid" = "$ZERO" ] && continue                 # branch deletion
    if [ "$remote_oid" = "$ZERO" ]; then
        commits=$(git rev-list "$local_oid" --not --remotes)
    else
        commits=$(git rev-list "$remote_oid..$local_oid")
    fi
    for sha in $commits; do
        trailer=$(git -c trailer.separators=: log -1 --format='%(trailers:key=Reviewed-by,valueonly)' "$sha")
        [ -n "$trailer" ] || missing="$missing $sha"
    done

    # Scan only commits in this push. Scanning the entire repository history
    # reports unrelated legacy findings and would block every future push.
    if command -v gitleaks >/dev/null 2>&1 && [ -n "$commits" ]; then
        if [ "$remote_oid" = "$ZERO" ]; then
            log_opts="--no-walk $commits"
        else
            log_opts="$remote_oid..$local_oid"
        fi
        echo "[pre-push] gitleaks detect --exit-code 1 --log-opts=<push range>"
        result=$(gitleaks detect --exit-code 1 --log-opts="$log_opts" 2>&1) || {
            echo "[pre-push] BLOCKED: gitleaks detected secrets in commits being pushed:" >&2
            echo "$result" >&2
            exit 1
        }
    fi
done

if [ -n "$missing" ]; then
    {
        echo "[pre-push] BLOCKED: these commits have no Reviewed-by trailer:"
        for sha in $missing; do
            echo "    $(git log -1 --format='%h %s' "$sha")"
        done
        echo
        echo "Review the diff with the talos-code-reviewer skill first"
        echo "(.agents/skills/talos-code-reviewer), fix what it finds, then record it:"
        echo
        echo "    git commit --amend --trailer 'Reviewed-by: talos-code-reviewer'"
        echo
        echo "(SKIP_CODE_REVIEW=1 bypasses this gate deliberately.)"
    } >&2
    exit 1
fi

# --- 2. the mechanical gates ----------------------------------------------
if [ -x .venv/bin/python ]; then PY=.venv/bin/python; else PY=python3; fi

echo "[pre-push] ruff check ."
"$PY" -m ruff check . || { echo "[pre-push] BLOCKED: ruff reported findings." >&2; exit 1; }

echo "[pre-push] pytest tests/"
PYTHONPATH=. "$PY" -m pytest tests/ -q || { echo "[pre-push] BLOCKED: tests failed." >&2; exit 1; }

echo "[pre-push] review gate passed."

# --- 4. chain: ECC hooks run inside Claude Code sessions -------------------
# The pre-push gate is git-scoped; ECC runs its own PreToolUse hooks
# (pre-bash-commit-quality, gateguard-fact-force, etc.) inside Claude Code
# sessions -- a separate execution context that never interferes with this gate.
#
# Inside a Claude Code session, its pre-bash-commit-quality hook fires before
# every `git commit`. The two gates are complementary:
#   .githooks/pre-push   : enforced at push time; cannot be bypassed from inside a session
#   ECC pre-bash-commit  : enforced at commit time; gates the commit itself
#
# To manually run the ECC pre-commit check:
#   node ~/.claude/scripts/hooks/pre-bash-commit-quality.js
# (It requires Claude Code's stdin context and won't run standalone here.)
#
# ECC hook profile (minimal | standard | strict) is controlled by ECC_HOOK_PROFILE
# and is entirely independent of this pre-push gate.
echo "[pre-push] ECC hooks (pre-bash-commit-quality, gateguard) run inside"
echo "[pre-push] Claude Code sessions on every 'git commit' -- no collision."
