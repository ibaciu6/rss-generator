# The password for the published HTML pages (scripts/pages_gate.py). Local
# only: what the repository carries is the public PBKDF2 verifier in
# config/pages-gate.json. Nothing may ever commit this file.
.pages_pass.txt
# Generated feeds, published by the update workflow. The workflow force-adds
# these after regenerating and pushes them to main, so raw.githubusercontent.com
# serves the latest copy. The entries stay so a local `git add .` never stages a
# feed the job has not put on main; never commit a feed by hand.
feeds/*.xml
feeds/*.html
feeds/manifest.json
feeds.opml
index.html
reader.html
config/sites.yaml.backup
github-pages/

# Transcript dumps dropped in the repo root by CLI tools
2026-*-local-command-*.txt
*-transcript*.txt
messages-below.txt

